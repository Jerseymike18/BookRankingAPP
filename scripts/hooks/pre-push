#!/usr/bin/env bash
#
# pre-push — the final gate, and the safety net for 'git commit --no-verify'
# (which skips pre-commit AND commit-msg). Two jobs:
#
#   * hard-constraint lint on EVERY push, per outgoing commit — engine edits
#     without a justification, raw SQL outside db_write, leaked keys. Runs above
#     the data fast path, because those violations usually carry no data change.
#   * for a push that DOES touch book data (or the snapshot): block unless the
#     committed snapshot is up to date and valid.
#
# git feeds ref lines on stdin: "<local-ref> <local-sha> <remote-ref> <remote-sha>".
# Non-interactive: aborts with the exact fix command, never prompts.
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hooks/_common.sh
. "$HERE/_common.sh"

# 1–3) Decide whether any outgoing commit touches data-affecting files or the
#      snapshot tree. If not, this push needs no Python/node (fast path). The same
#      pass collects the outgoing commits for the hard-constraint backstop below.
needs_check=0
outgoing=""
# Fields: <local-ref> <local-sha> <remote-ref> <remote-sha>. The refs are
# unused here, so read them into throwaway `_`.
while read -r _ local_sha _ remote_sha; do
  # Skip branch deletions (local sha all zeros).
  if [ -z "${local_sha:-}" ] || [ -z "${local_sha//0/}" ]; then
    continue
  fi
  if [ -z "${remote_sha:-}" ] || [ -z "${remote_sha//0/}" ]; then
    # New branch on the remote: no range to diff — check the tip commit's tree,
    # and treat everything not yet on ANY remote as outgoing.
    if changed="$(git -C "$REPO_ROOT" diff-tree --no-commit-id --name-only -r "$local_sha" 2>/dev/null)"; then
      if printf '%s\n' "$changed" | paths_need_export; then needs_check=1; fi
    else
      needs_check=1   # couldn't determine — validate to be safe
    fi
    revs="$(git -C "$REPO_ROOT" rev-list "$local_sha" --not --remotes 2>/dev/null || true)"
  else
    if changed="$(git -C "$REPO_ROOT" diff --name-only "$remote_sha..$local_sha" 2>/dev/null)"; then
      if printf '%s\n' "$changed" | paths_need_export; then needs_check=1; fi
    else
      needs_check=1   # couldn't determine — validate to be safe
    fi
    revs="$(git -C "$REPO_ROOT" rev-list "$remote_sha..$local_sha" 2>/dev/null || true)"
  fi
  if [ -n "$revs" ]; then
    outgoing="${outgoing}${revs}
"
  fi
done

# 3.5) HARD-CONSTRAINT BACKSTOP (CLAUDE.md HARD CONSTRAINTS).
#
# Deliberately ABOVE the data fast path: the violations this catches — an engine
# edit, raw SQL outside db_write, a leaked key, a resid_sd interval — usually
# carry no data change at all, so gating it behind needs_check would let exactly
# the wrong things through. This is the net for `git commit --no-verify`, which
# skips pre-commit AND commit-msg.
#
# Linted PER COMMIT, not across the whole push range, because the marker check
# reads commit messages: over a range, one commit's 'engine-change: <reason>'
# would license a DIFFERENT commit's unexplained engine edit. Per commit, each
# engine change must carry its own justification.
if command -v python3 >/dev/null 2>&1 && [ -n "$outgoing" ]; then
  # Newest first, de-duplicated (several refs can share commits).
  commits="$(printf '%s' "$outgoing" | grep . | awk '!seen[$0]++' || true)"
  n_out="$(printf '%s\n' "$commits" | grep -c . || true)"
  max_lint=50
  if [ "$n_out" -gt "$max_lint" ]; then
    echo "⚠ pre-push: $n_out outgoing commits — constraint-linting the newest $max_lint." >&2
    echo "  The older $((n_out - max_lint)) are NOT checked here; run" >&2
    echo "  'python3 scripts/lint_constraints.py --range <base>..HEAD' for the full sweep." >&2
    commits="$(printf '%s\n' "$commits" | head -n "$max_lint")"
  fi
  constraint_failed=0
  for sha in $commits; do
    # A root commit has no parent, so there is no A..B range to diff against.
    # Say so rather than skipping silently.
    if ! git -C "$REPO_ROOT" rev-parse -q --verify "$sha^1" >/dev/null 2>&1; then
      echo "⚠ pre-push: $(git -C "$REPO_ROOT" log --format=%h -1 "$sha") is a root commit — not constraint-linted." >&2
      continue
    fi
    if ! python3 "$REPO_ROOT/scripts/lint_constraints.py" \
           --range "$sha~1..$sha" >/dev/null 2>&1; then
      # Re-run visibly so the findings print with their own fixes.
      echo "── constraint violations in $(git -C "$REPO_ROOT" log --format=%h\ %s -1 "$sha") ──" >&2
      python3 "$REPO_ROOT/scripts/lint_constraints.py" --range "$sha~1..$sha" >&2 || true
      constraint_failed=1
    fi
  done
  if [ "$constraint_failed" -ne 0 ]; then
    echo "✗ pre-push: hard-constraint lint FAILED — push blocked." >&2
    echo "  Each ERROR above prints its own fix. A SANCTIONED engine change needs" >&2
    echo "  an 'engine-change: <reason>' line in that commit's own message body;" >&2
    echo "  amend it ('git commit --amend') or rebase to add one, then push." >&2
    exit 1
  fi
fi

if [ "$needs_check" -eq 0 ]; then
  exit 0
fi

# 4) This push carries data. The environment must be able to validate it.
require_tools

# The --check reads the on-disk books.db + snapshot, so those must equal the
# committed tree or the check would validate the wrong state. Require both the
# worktree and the index clean for those paths.
if ! git -C "$REPO_ROOT" diff --quiet -- books.db "$SNAPSHOT_PREFIX" \
   || ! git -C "$REPO_ROOT" diff --cached --quiet -- books.db "$SNAPSHOT_PREFIX"; then
  echo "✗ pre-push: books.db or the snapshot has uncommitted changes — cannot honestly validate the committed state." >&2
  echo "  Fix: commit them ('git commit -am \"data: …\"' regenerates the snapshot) or stash them ('git stash'), then push." >&2
  exit 1
fi

# Non-blocking: warn if the Excel workbook is newer than books.db. The site
# reads books.db only; workbook edits never reach it (see the brief). Never
# blocks — this is purely a heads-up.
XLSX="$REPO_ROOT/BookRankingsNew.xlsx"
if [ -f "$XLSX" ] && [ "$XLSX" -nt "$REPO_ROOT/books.db" ]; then
  echo "⚠ pre-push: BookRankingsNew.xlsx is newer than books.db." >&2
  echo "  Note: the site reads books.db only — workbook edits do NOT reach it. (not blocking)" >&2
fi

# 5) The staleness gate. --check regenerates into a temp dir and byte-compares.
if ! python3 "$EXPORT_SCRIPT" --check; then
  echo "✗ pre-push: snapshot is STALE relative to books.db — push blocked." >&2
  echo "  Fix: run 'scripts/publish.sh' — it regenerates the snapshot, commits, and pushes." >&2
  echo "       (Manual: 'python3 scripts/export_static_data.py && git commit -am \"data: refresh snapshot\"', then push.)" >&2
  exit 1
fi

# Remaining cheap validations (JSON parse-back is already covered by --check).
# No dev URL must leak into the static data.
if grep -rIl "localhost:8000" "$REPO_ROOT/$SNAPSHOT_PREFIX" >/dev/null 2>&1; then
  echo "✗ pre-push: 'localhost:8000' found in the snapshot — push blocked." >&2
  echo "  Fix: re-export ('scripts/publish.sh' or 'git commit') so the static data carries no dev URLs." >&2
  exit 1
fi

# Score-file count must equal the fiction book count.
if ! python3 - "$REPO_ROOT/frontend/public/data" <<'PY'
import json, os, sys
d = sys.argv[1]
try:
    with open(os.path.join(d, "fiction/books.json"), encoding="utf-8") as f:
        n_books = len(json.load(f)["books"])
    scores = os.path.join(d, "fiction/scores")
    n_scores = len([x for x in os.listdir(scores) if x.endswith(".json")])
except Exception as exc:  # noqa: BLE001
    print(f"pre-push: could not verify score-file count: {exc}", file=sys.stderr)
    sys.exit(1)
if n_books != n_scores:
    print(f"pre-push: score-file count {n_scores} != fiction book count {n_books}", file=sys.stderr)
    sys.exit(1)
PY
then
  echo "  Fix: 'git commit -am \"data: refresh snapshot\"' to regenerate a consistent snapshot, then push." >&2
  exit 1
fi

# Doc-drift audit (cheap: --no-run-tests skips the slow test_engine.py run). Blocks
# a push whose CLAUDE.md / ARCHITECTURE.md claims have drifted from repo ground
# truth. The FULL audit (incl. the test-gate count) is a manual / CI run.
if ! python3 "$REPO_ROOT/scripts/lint_docs.py" --no-run-tests; then
  echo "✗ pre-push: doc drift detected — push blocked." >&2
  echo "  Fix: 'python3 scripts/lint_docs.py --fix' rewrites NUMERIC drift; edit the" >&2
  echo "       page list in CLAUDE.md/ARCHITECTURE.md by hand for structural findings." >&2
  exit 1
fi

exit 0
